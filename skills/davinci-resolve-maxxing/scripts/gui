#!/usr/bin/env bash
# Drive Resolve's GUI on Linux/X11 (xdotool + ImageMagick). Coordinates are relative to the target window.
#   gui wins                         list visible Resolve windows: id, title, x y w h
#   gui shot out.png [x y w h]       screenshot the main window (optionally a crop of it)
#   gui key ctrl+s [key ...]         activate the main window, then press keys (xdotool key names)
#   gui click x y [right|double]     click inside the main window
#   gui drag x1 y1 x2 y2             press at (x1,y1), move, release at (x2,y2)
#   gui scroll x y up|down [n]       wheel n notches at (x,y)
#   gui type 'text'                  type into the focused field. Main window: numbers only (letters are shortcuts)
#   gui field x y value              double-click a number field, select all, type value, Return
# GUI_WIN=<title regex | window id> retargets every command, e.g. GUI_WIN='^Preferences$' or GUI_WIN=39846500.
# Resolve REUSES top-level windows for its panels: a Dynamics panel can be titled "Patch Input/Output".
# Identify panels by screenshot, then target them by id.
XDO=$(command -v xdotool || command -v xdo) || { echo "gui: xdotool missing (run install.sh)" >&2; exit 1; }
export DISPLAY=${DISPLAY:-:1}
win(){  # GUI_WIN: a window id (digits) or a title regex
  case $GUI_WIN in *[!0-9]*|'') $XDO search --onlyvisible --name "${GUI_WIN:-^DaVinci Resolve - }" 2>/dev/null | head -1 ;; *) echo "$GUI_WIN" ;; esac; }
geom(){ eval "$($XDO getwindowgeometry --shell "$1")"; }
cmd=$1; shift
case $cmd in
  wins)
    for w in $($XDO search --onlyvisible --class resolve 2>/dev/null); do
      geom "$w"; echo "$w $($XDO getwindowname "$w") $X $Y $WIDTH $HEIGHT"
    done ;;
  shot)
    w=$(win); [ -z "$w" ] && { echo "gui: no window" >&2; exit 1; }
    if [ $# -ge 5 ]; then import -window "$w" -crop "${4}x${5}+${2}+${3}" +repage "$1"; else import -window "$w" "$1"; fi ;;
  key)
    w=$(win); [ -z "$w" ] && { echo "gui: no window" >&2; exit 1; }
    $XDO windowactivate --sync "$w"; for k in "$@"; do $XDO key --clearmodifiers "$k"; sleep 0.25; done ;;
  click|drag|scroll)
    w=$(win); [ -z "$w" ] && { echo "gui: no window" >&2; exit 1; }
    $XDO windowactivate --sync "$w"; geom "$w"
    case $cmd in
      click)
        $XDO mousemove $((X + $1)) $((Y + $2)); sleep 0.1
        case $3 in right) $XDO click 3 ;; double) $XDO click --repeat 2 --delay 80 1 ;; *) $XDO click 1 ;; esac ;;
      drag)
        $XDO mousemove $((X + $1)) $((Y + $2)) mousedown 1; sleep 0.15
        $XDO mousemove $((X + ($1 + $3) / 2)) $((Y + ($2 + $4) / 2)); sleep 0.1
        $XDO mousemove $((X + $3)) $((Y + $4)); sleep 0.15; $XDO mouseup 1 ;;
      scroll)
        $XDO mousemove $((X + $1)) $((Y + $2)); b=4; [ "$3" = down ] && b=5
        $XDO click --repeat "${4:-1}" --delay 40 $b ;;
    esac ;;
  type)
    f=$($XDO getactivewindow); case "$($XDO getwindowname "$f")" in "DaVinci Resolve - "*)
      # numeric fields in the main window (Primaries, Inspector) are fine: digits . - : never open dialogs
      [[ $1 =~ ^[-0-9.:]+$ ]] || { echo "gui: refusing to type letters into the main window (they are shortcuts)" >&2; exit 1; } ;; esac
    $XDO type --delay 15 -- "$1" ;;
  field)
    "$0" click "$1" "$2" double; sleep 0.25; $XDO key ctrl+a; "$0" type "$3" && $XDO key Return; sleep 0.3 ;;
  *) sed -n '2,13p' "$0"; exit 1 ;;
esac
