#!/usr/bin/env bash
# Bring free DaVinci Resolve (Linux/X11) to a scriptable state and start the Lua bridge. Safe to rerun.
# Usage: resolve-up [project-name]    (saves the current project, then loads project-name, or CREATES it if it doesn't exist;
#   Resolve stays on project-name: run resolve-up <previous-name> to go back)
#   1. clicks "Ignore" on a leftover crash report (never "Send": that uploads data)
#   2. launches Resolve if needed, waits for the Project Manager, opens the most recent project (first tile)
#   3. closes modal windows (Project Settings, Preferences, dialogs) that would swallow keystrokes
#   4. starts bridge.lua in the Lua Console, then loads/creates project-name through the API
set -u
case "${1:-}" in -h|--help) sed -n '2,8p' "$0"; exit 0 ;; -*) echo "resolve-up: project names can't start with '-' ($1)" >&2; exit 2 ;; esac
DIR=$(dirname "$(readlink -f "$0")")
XDO=$(command -v xdotool || command -v xdo) || { echo "resolve-up: xdotool missing (run install.sh)" >&2; exit 1; }
RESOLVE=${RESOLVE_BIN:-/opt/resolve/bin/resolve}
log(){ echo "resolve-up: $*" >&2; }
win(){ $XDO search --onlyvisible --name "$1" 2>/dev/null | head -1; }
alive(){ pgrep -f "^$RESOLVE" >/dev/null; }  # the main process renames itself "GUI Thread": match the command line
bridge(){ RV_TIMEOUT=${1:-3} "$DIR/rv" 'return "ok"' >/dev/null 2>&1; }
# NVIDIA: after a suspend/resume CUDA often stays dead (cuInit = 999) and Resolve stops at "Unsupported GPU Processing Mode"
cuda_ok(){ python3 -c 'import ctypes, sys
try: c = ctypes.CDLL("libcuda.so.1")
except OSError: sys.exit(0)
sys.exit(c.cuInit(0))' 2>/dev/null; }
load(){
  RV_TIMEOUT=5 "$DIR/rv" 'reload() return 1' >/dev/null 2>&1  # pick up lib.lua edits made while the bridge ran
  [ -z "${1:-}" ] && return 0
  RV_TIMEOUT=60 "$DIR/rv" "local pm = resolve:GetProjectManager()
    local cur = pm:GetCurrentProject()
    if cur and cur:GetName() == [[$1]] then return 'project: already open' end
    pm:SaveProject()
    if pm:LoadProject([[$1]]) then return 'project: loaded' end
    if pm:CreateProject([[$1]]) then return 'project: created' end
    return 'project: FAILED to load or create'" && return 0
  # a failed load usually means a dialog: the Studio upsell for a Studio-only feature in the project, then "Unable to Open Project"
  for w in $($XDO search --onlyvisible --name '^(Message|Warning|Error)$' 2>/dev/null); do
    log "dialog open: '$($XDO getwindowname "$w")' (window $w). Look: GUI_WIN=$w gui shot /tmp/d.png; close: GUI_WIN=$w gui key Escape"
  done
  grep -a 'not supported\|Unable to open\|failed to open' "$HOME/.local/share/DaVinciResolve/logs/ResolveDebug.txt" 2>/dev/null | tail -3 | cut -c1-200 >&2
  return 1
}

if bridge; then log "bridge already up"; load "${1:-}"; exit $?; fi

crash=$(win '^Problem Report for DaVinci Resolve$')
if [ -n "$crash" ]; then  # Ignore sits at (365,341) in the 550x373 report window
  eval "$($XDO getwindowgeometry --shell "$crash")"
  $XDO windowactivate --sync "$crash"; $XDO mousemove $((X + 365)) $((Y + 341)) click 1; sleep 2
  log "dismissed crash report (Ignore)"
fi

if [ -z "$(win '^DaVinci Resolve - ')" ]; then
  if ! alive; then
    cuda_ok || { log "CUDA is down (cuInit fails, usual after suspend/resume): Resolve can't process. Fix with Resolve closed:"
                 log "  sudo rmmod nvidia_uvm && sudo modprobe nvidia_uvm   (or reboot), then rerun"; exit 1; }
    setsid nohup "$RESOLVE" >/dev/null 2>&1 < /dev/null & disown; log "launching Resolve"
  fi
  for _ in $(seq 90); do
    [ -n "$(win '^Project Manager$')" ] || [ -n "$(win '^DaVinci Resolve - ')" ] && break
    sleep 2
  done
  pm=$(win '^Project Manager$')
  if [ -n "$pm" ] && [ -z "$(win '^DaVinci Resolve - ')" ]; then  # first tile after "New Project" = most recent project
    sleep 2; eval "$($XDO getwindowgeometry --shell "$pm")"
    $XDO windowactivate --sync "$pm"; $XDO mousemove $((X + 414)) $((Y + 176)) click --repeat 2 --delay 120 1
    for _ in $(seq 45); do [ -n "$(win '^DaVinci Resolve - ')" ] && break; sleep 2; done
    sleep 4
  fi
fi
[ -z "$(win '^DaVinci Resolve - ')" ] && { log "no project window (empty Project Manager?): create a project by hand, then rerun"; exit 1; }

for w in $($XDO search --onlyvisible --class resolve 2>/dev/null); do
  n=$($XDO getwindowname "$w" 2>/dev/null)
  case "$n" in "DaVinci Resolve - "*|resolve|"") ;; *) log "closing '$n' (Escape)"; $XDO windowactivate --sync "$w"; $XDO key Escape; sleep 1;; esac
done

"$DIR/rcon" 'dofile(os.getenv("HOME").."/resolve-bridge/bridge.lua")' || exit 1
for _ in $(seq 10); do bridge 2 && break; done
bridge 5 || { log "bridge did not answer"; exit 1; }
log "bridge up"
load "${1:-}"
